@model Sareoo.ViewModels.CoursePlayerViewModel
@using Sareoo.Helpers

@{
    ViewData["Title"] = Model.CourseTitle;
    Layout = "_Layout";
}

<style>
    :root {
        --dark-bg: #0b261d;
        --panel-bg: #154734;
        --text-primary: #e6f2eb;
        --text-secondary: #c9d6d1;
        --accent: #d4af37;
        --border: #d4af37;
    }

    body {
        background-color: var(--dark-bg);
        color: var(--text-primary);
    }

    .course-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        min-height: calc(100vh - 80px);
    }

    /* --- تحسينات تصميم الفولدرات والشريط الجانبي --- */
    .sidebar {
        background-color: var(--panel-bg);
        border-left: 1px solid var(--border);
        padding: 1.5rem;
        overflow-y: auto;
        height: 100%;
    }

        .sidebar h2 {
            color: var(--accent);
            font-size: 1.4rem;
            margin-bottom: 1.5rem;
            font-weight: bold;
            border-bottom: 1px solid var(--border);
            padding-bottom: 10px;
        }

    /* --- تحسينات تصميم الفولدرات والشجرة (Tree Style) --- */
    .folder-group {
        margin-bottom: 1rem;
        background: rgba(0, 0, 0, 0.15);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(212, 175, 55, 0.1);
        transition: all 0.3s ease;
    }

    .folder-header {
        padding: 12px 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        background: linear-gradient(90deg, rgba(212,175,55,0.05) 0%, transparent 100%);
        transition: all 0.3s ease;
    }

        .folder-header:hover {
            background-color: rgba(212, 175, 55, 0.15);
        }

        .folder-header h3 {
            margin: 0;
            font-size: 1.1rem;
            color: var(--accent);
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .folder-icon {
        font-size: 1.2rem;
    }

    .chevron-icon {
        transition: transform 0.3s ease;
        font-size: 0.9rem;
        color: var(--text-secondary);
    }

    .folder-header[aria-expanded="true"] .chevron-icon {
        transform: rotate(180deg);
        color: var(--accent);
    }

    .folder-lessons {
        border-right: 2px solid rgba(212, 175, 55, 0.2);
        margin-right: 1.5rem;
        padding-right: 0.8rem;
        padding-bottom: 0.8rem;
    }

    .lesson-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0.8rem 1rem;
        margin-top: 0.5rem;
        color: var(--text-secondary);
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.3s ease;
        position: relative;
        font-weight: 500;
    }

        .lesson-link:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.05);
            transform: translateX(-5px);
        }

        .lesson-link.active {
            background: var(--accent);
            color: var(--dark-bg);
            font-weight: bold;
            box-shadow: 0 4px 10px rgba(212, 175, 55, 0.2);
        }

        .lesson-link::before {
            content: '';
            position: absolute;
            right: -1.1rem;
            width: 10px;
            height: 10px;
            background: rgba(212, 175, 55, 0.3);
            border-radius: 50%;
            transform: translateY(1px);
            transition: all 0.3s ease;
        }

        .lesson-link:hover::before {
            background: rgba(212, 175, 55, 0.8);
        }

        .lesson-link.active::before {
            background: var(--accent);
            box-shadow: 0 0 8px var(--accent);
        }

    .main-content {
        padding: 2rem;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        background-color: var(--dark-bg);
    }

    .video-wrapper {
        position: relative;
        padding-top: 56.25%;
        border-radius: 15px;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 0 20px rgba(21, 71, 52, 0.5);
        border: 2px solid var(--border);
        background-color: #000;
    }

        .video-wrapper iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

    .nav-controls {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        gap: 10px;
    }

        .nav-controls a,
        .nav-controls button {
            padding: 0.6rem 1.5rem;
            border-radius: 25px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

    .btn-primary {
        background-color: var(--accent);
        border-color: var(--accent);
        color: #0b261d;
    }

        .btn-primary:hover {
            background-color: #b08d26;
            color: #fff;
        }

    .btn-outline-light {
        color: var(--accent);
        border-color: var(--accent);
    }

        .btn-outline-light:hover {
            background-color: var(--accent);
            color: #0b261d;
        }

    .btn-success {
        background-color: #0e2e23;
        border: 2px solid var(--accent);
        color: #fff;
    }

        .btn-success:hover {
            background-color: var(--accent);
            color: #0b261d;
        }

    .section-box {
        background-color: var(--panel-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        color: var(--accent);
        font-size: 1.2rem;
        font-weight: bold;
    }

    .attachments-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .attachments-list li {
            margin-bottom: 0.75rem;
            background-color: rgba(0,0,0,0.2);
            padding: 8px;
            border-radius: 8px;
        }

        .attachments-list a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 500;
        }

            .attachments-list a:hover {
                color: #fff;
            }

    @@media (max-width: 768px) {
        .course-layout

    {
        display: block;
    }

    .sidebar {
        width: 100%;
        max-height: 350px;
        margin-bottom: 20px;
        border-left: none;
        border-bottom: 1px solid var(--border);
    }

    .main-content {
        padding: 1rem;
    }

    }
</style>

<div class="course-layout">
    <div class="sidebar">
        <h2>@Model.CourseTitle</h2>
        @{
            var groupedLessons = Model.AllLessons.GroupBy(l => string.IsNullOrWhiteSpace(l.SectionName) ? "دروس عامة" : l.SectionName);
            int folderIndex = 0;
        }
        @foreach (var group in groupedLessons)
        {
            bool isFolderActive = group.Any(l => l.Id == Model.CurrentLesson.Id);
            string collapseId = $"folder-{folderIndex}";

            <div class="folder-group shadow-sm">
                <!-- التعديل: استخدام Bootstrap Collapse لحركة انسيابية -->
                <div class="folder-header" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(isFolderActive ? "true" : "false")" aria-controls="@collapseId">
                    <h3><i class="fas fa-folder-open folder-icon"></i> @group.Key</h3>
                    <i class="fas fa-chevron-down chevron-icon"></i>
                </div>

                <div class="collapse @(isFolderActive ? "show" : "")" id="@collapseId">
                    <div class="folder-lessons">
                        @foreach (var lesson in group)
                        {
                            <!-- التعديل الجذري لحل مشكلة الـ 404: تحويله إلى رابط حقيقي -->
                            <a asp-controller="CoursePlayer" asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-lessonId="@lesson.Id"
                               class="lesson-link @(lesson.Id == Model.CurrentLesson.Id ? "active" : "")">
                                <i class="fas @(lesson.Id == Model.CurrentLesson.Id ? "fa-play" : "fa-play-circle")"></i>
                                <span>@lesson.Title</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
            folderIndex++;
        }
    </div>

    <div class="main-content">
        <div class="mb-4">
            <a href="/Profile" style="border: 1px solid var(--border); color: var(--accent); padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; transition: 0.3s;">
                <i class="fas fa-arrow-right"></i> العودة إلى الملف الشخصي
            </a>
        </div>

        <div class="video-wrapper">
            @if (!string.IsNullOrEmpty(Model.CurrentLesson.BunnyLibraryId) && !string.IsNullOrEmpty(Model.CurrentLesson.BunnyVideoId))
            {
                <iframe src="https://iframe.mediadelivery.net/embed/@Model.CurrentLesson.BunnyLibraryId/@Model.CurrentLesson.BunnyVideoId?autoplay=false&loop=false&muted=false&preload=true&responsive=true"
                        loading="lazy" allow="accelerometer; gyroscope; encrypted-media; picture-in-picture;" allowfullscreen="true">
                </iframe>
            }
            else if (!string.IsNullOrEmpty(Model.CurrentLesson.VideoUrl))
            {
                <iframe src="@YouTubeHelper.GetEmbedUrl(Model.CurrentLesson.VideoUrl)" title="YouTube video player" frameborder="0" allow="accelerometer;  clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            }
            else
            {
                <div class="d-flex justify-content-center align-items-center h-100 w-100 text-white">
                    <div class="text-center">
                        <i class="fas fa-video-slash fa-3x text-muted mb-3"></i>
                        <p>لا يوجد فيديو متاح لهذا الدرس.</p>
                    </div>
                </div>
            }
        </div>

        <div class="nav-controls">
            @if (Model.PreviousLessonId.HasValue)
            {
                <a asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-lessonId="@Model.PreviousLessonId" class="btn btn-outline-light"><i class="fas fa-chevron-right me-2"></i> الدرس السابق</a>
            }
            else
            {
                <button class="btn btn-outline-light" disabled style="opacity: 0.5;"><i class="fas fa-chevron-right me-2"></i> الدرس السابق</button>
            }

            <div class="sidebar-footer-pro" style="display: @(Model.IsCourseCompleted ? "block" : "none");">
                <a asp-controller="Exam" asp-action="Take" asp-route-id="@Model.CourseId" class="btn btn-success fw-bold"><i class="fas fa-file-alt me-2"></i> ابدأ الاختبار النهائي</a>
            </div>

            @if (Model.NextLessonId.HasValue)
            {
                <a asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-lessonId="@Model.NextLessonId" class="btn btn-primary">الدرس التالي <i class="fas fa-chevron-left ms-2"></i></a>
            }
            else
            {
                <p class="text-center text-white-50 small align-self-center m-0">لقد أكملت جميع دروس الدورة!</p>
            }
        </div>

        <div class="row g-4 mt-2">
            <!-- Attachments -->
            <div class="col-md-6">
                <div class="section-box h-100 shadow-sm">
                    <div class="section-header">
                        <i class="fas fa-paperclip"></i><span>المرفقات والملفات</span>
                    </div>
                    <div class="section-body mt-3">
                        @if (Model.LessonDetails.Attachments.Any())
                        {
                            <ul class="attachments-list">
                                @foreach (var attachment in Model.LessonDetails.Attachments)
                                {
                                    <li class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <i class="fas fa-file-pdf me-2 text-[#d4af37]"></i>
                                            <a href="@Url.Content(attachment.FilePath)" download>@attachment.FileName</a>
                                        </div>
                                        <a href="@Url.Content(attachment.FilePath)" download class="btn btn-sm" style="background: rgba(212,175,55,0.2); color: var(--accent);"><i class="fas fa-download"></i></a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted text-center py-3"><i class="fas fa-folder-open mb-2 text-secondary fa-2x d-block"></i> لا توجد مرفقات لهذا الدرس.</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Quiz -->
            <div class="col-md-6">
                <div class="section-box h-100 d-flex flex-column shadow-sm">
                    <div class="section-header">
                        <i class="fas fa-question-circle"></i><span>اختبار الدرس السريع</span>
                    </div>
                    <div class="section-body flex-grow-1 d-flex flex-column justify-content-center align-items-center mt-3">
                        @if (Model.CurrentLesson.LessonQuiz != null)
                        {
                            <p class="text-center mb-4 text-white">يوجد اختبار قصير لتحديد مستوى فهمك لهذا الدرس.</p>
                            <a asp-controller="LessonQuizPlayer" asp-action="Take" asp-route-lessonId="@Model.CurrentLesson.Id" class="btn" style="background:transparent; border:2px solid #d4af37; color:#d4af37; border-radius:50px; padding:10px 30px; font-weight:bold; transition: 0.3s;" onmouseover="this.style.background='#d4af37'; this.style.color='#0b261d';" onmouseout="this.style.background='transparent'; this.style.color='#d4af37';">
                                <i class="fas fa-pencil-alt me-2"></i> ابدأ الاختبار الآن
                            </a>
                        }
                        else
                        {
                            <p class="text-muted text-center py-3"><i class="fas fa-clipboard-check mb-2 text-secondary fa-2x d-block"></i> لا يوجد اختبار مخصص لهذا الدرس.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>