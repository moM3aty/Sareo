@model IEnumerable<Sareoo.Areas.Admin.Models.Entities.StudentCourse>

@{
    ViewData["Title"] = "الطلاب المشتركون فعلياً";
}

<div class="max-w-6xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-3xl font-bold">الطلاب المشتركون في: <span class="text-[#d4af37]">@ViewBag.CourseTitle</span></h2>
        <a asp-action="Index" class="secondary-btn px-5 py-2 rounded-lg flex items-center">
            <i class="fas fa-arrow-right ml-2"></i> العودة للدورات
        </a>
    </div>

    <div class="card-bg rounded-lg overflow-hidden">
        <table class="w-full text-right">
            <thead class="bg-[#2a3a50]">
                <tr>
                    <th class="p-4 font-semibold">اسم الطالب</th>
                    <th class="p-4 font-semibold">البريد الإلكتروني</th>
                    <th class="p-4 font-semibold">تاريخ الانتهاء</th>
                    <th class="p-4 font-semibold">نسبة التقدم</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="border-b border-gray-700 hover:bg-[#2a3a50]/50 transition-colors">
                            <td class="p-4">@item.Student.FullName</td>
                            <td class="p-4">@item.Student.Email</td>
                            <td class="p-4 text-green-400 font-bold">@item.ExpiryDate.Value.ToString("yyyy/MM/dd")</td>
                            <td class="p-4">
                                <div class="flex items-center gap-2">
                                    <div class="w-full bg-gray-700 rounded-full h-2.5 max-w-[100px]">
                                        <div class="bg-blue-600 h-2.5 rounded-full" style="width: @item.ProgressPercentage%"></div>
                                    </div>
                                    <span>@item.ProgressPercentage%</span>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="p-6 text-center text-gray-400">لا يوجد طلاب باشتراكات فعّالة حالياً في هذه الدورة.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>